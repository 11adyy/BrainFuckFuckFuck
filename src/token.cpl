#include "../include/token_h.cpl"

function token_line::set(ptr token_line self, ptr i8 buffer, u64 bsize) -> i0 {
    self.buffer      = buffer;
    self.buffer_size = bsize;
    self.pos         = -1 as i64;
}

function token_line::next(ptr token_line self) -> i32 {
    self.pos += 1;
    if self.pos >= self.buffer_size as i64; {
        return -1;
    }

    self.buffer[self.pos] as i32
}
